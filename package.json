{
  "name": "mufu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.scripts.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "eslint . && knip && depcheck && pnpm -r exec depcheck && pnpm deps",
    "test": "vitest run",
    "deps": "depcruise packages scripts --config .dependency-cruiser.cjs",
    "check": "pnpm lint",
    "build": "pnpm -r --if-present build",
    "start": "tsx scripts/start.ts",
    "mufu": "tsx packages/cli/src/main.ts",
    "daemon": "tsx packages/daemon/src/bin.ts",
    "dev:app": "pnpm --filter @mufu/app dev",
    "verify:mac": "tsx scripts/verify-mac.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@mufu/adapters": "workspace:*",
    "@mufu/core": "workspace:*",
    "@mufu/daemon": "workspace:*",
    "@mufu/schema": "workspace:*",
    "@types/node": "^22.15.0",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-tencent": "1.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "knip": "^5.88.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
